{
  "$schema": "https://mirai-graph.dev/schemas/graph-manifest.schema.json",
  "format": "mirai-graph",
  "schema_version": "2.0.0",
  "id": "project.mirai",
  "aliases": [],
  "title": "Mirai",
  "scope": "repository",
  "kind": "project_graph",
  "owner": "repository_owner",
  "profiles": [
    "project_management",
    "implementation_control"
  ],
  "graph": {
    "root": "mirai/graph",
    "source_of_truth": [
      "mirai/graph"
    ],
    "objects": [
      "mirai/graph/specs/project.json"
    ],
    "relations": [
      "mirai/graph/specs/relations.json"
    ],
    "schemas": [],
    "generated": [],
    "raw_sources": [
      "mirai/sources.yaml"
    ]
  },
  "imports": [],
  "extensions": {
    "mirai.project_technology": {
      "context_policy": "task_scoped",
      "continuity_policy": "task_boundary",
      "contract_version": "1.0.0",
      "enabled": true,
      "source_boundary": "hybrid_sot"
    }
  }
}
