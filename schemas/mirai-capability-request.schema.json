{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-capability-request.schema.json",
  "title": "Mirai Capability Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "run_id", "program_digest", "input_digest", "args_digest", "node_id", "adapter", "action", "resource", "effects", "capability", "budget", "policy_digest", "approval_required", "request_digest"],
  "properties": {
    "contract_version": { "const": "1.1.0" },
    "request_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "program_digest": { "$ref": "#/$defs/digest" },
    "input_digest": { "$ref": "#/$defs/digest" },
    "args_digest": { "$ref": "#/$defs/digest" },
    "node_id": { "$ref": "#/$defs/id" },
    "adapter": { "$ref": "#/$defs/id" },
    "action": { "$ref": "#/$defs/id" },
    "resource": { "type": "string", "minLength": 1 },
    "effects": { "$ref": "#/$defs/effects" },
    "capability": { "$ref": "#/$defs/id" },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["max_calls"],
      "properties": {
        "max_calls": { "type": "integer", "minimum": 1 },
        "max_bytes": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "approval_required": { "type": "boolean" },
    "request_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "effects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["repository_read", "git_read", "workspace_patch", "process_run", "human_approval"] } }
  }
}
