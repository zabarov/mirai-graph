{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-project-migration-result.schema.json",
  "title": "Mirai Project Migration Result",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "project_root", "mode", "status", "source_layout", "target_layout", "inventory", "path_map", "conflicts", "rollback_plan", "approval_ref", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" }, "project_root": { "type": "string" }, "mode": { "enum": ["dry_run", "apply", "rollback"] },
    "status": { "enum": ["ready", "applied", "rolled_back", "blocked", "already_current"] }, "source_layout": { "const": "graph_v2" }, "target_layout": { "const": "mirai_project_capsule" },
    "inventory": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": { "path": { "type": "string" }, "digest": { "$ref": "#/$defs/digest" } } } },
    "path_map": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "type": "string" }, "to": { "type": "string" } } } },
    "conflicts": { "$ref": "#/$defs/strings" }, "rollback_plan": { "$ref": "#/$defs/strings" }, "approval_ref": { "type": ["string", "null"] },
    "canonical_write_allowed": { "type": "boolean" }, "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "strings": { "type": "array", "items": { "type": "string" } } }
}
