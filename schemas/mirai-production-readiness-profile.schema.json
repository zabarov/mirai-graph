{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-production-readiness-profile.schema.json",
  "title": "Mirai Production Readiness Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "id",
    "target",
    "evaluated_tier",
    "verdict",
    "contracts",
    "controls",
    "runtime_composition",
    "recovery",
    "external_reviews",
    "stop_conditions",
    "canonical_write_allowed",
    "claim_boundary"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^readiness\\.[a-z0-9._-]+$" },
    "target": { "type": "string", "minLength": 1 },
    "evaluated_tier": {
      "enum": ["experimental", "pilot", "production_read", "production_write"]
    },
    "verdict": { "enum": ["ready", "blocked"] },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "status", "evidence_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "status": { "enum": ["stable", "freeze_candidate", "draft"] },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_policy_ref",
        "approval_policy_ref",
        "sandbox_policy_ref",
        "backup_plan_ref",
        "rollback_plan_ref",
        "incident_runbook_ref",
        "retention_policy_ref",
        "monitoring_ref",
        "sanitized_evidence_only",
        "host_process_run_allowed"
      ],
      "properties": {
        "capability_policy_ref": { "type": "string", "minLength": 1 },
        "approval_policy_ref": { "type": "string", "minLength": 1 },
        "sandbox_policy_ref": { "type": "string", "minLength": 1 },
        "backup_plan_ref": { "type": "string", "minLength": 1 },
        "rollback_plan_ref": { "type": "string", "minLength": 1 },
        "incident_runbook_ref": { "type": "string", "minLength": 1 },
        "retention_policy_ref": { "type": "string", "minLength": 1 },
        "monitoring_ref": { "type": "string", "minLength": 1 },
        "sanitized_evidence_only": { "const": true },
        "host_process_run_allowed": { "const": false }
      }
    },
    "runtime_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registered_adapters", "registered_effects"],
      "properties": {
        "registered_adapters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "registered_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["repository_read", "git_read", "workspace_patch", "process_run", "human_approval"] }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertain_effect_action", "duplicate_resume_action", "failed_compensation_action"],
      "properties": {
        "uncertain_effect_action": { "const": "block_and_reconcile" },
        "duplicate_resume_action": { "const": "reject_or_reuse_verified_receipt" },
        "failed_compensation_action": { "const": "block_and_escalate" }
      }
    },
    "external_reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security", "human"],
      "properties": {
        "security": { "$ref": "#/$defs/review" },
        "human": { "$ref": "#/$defs/review" }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonical_write_allowed": { "const": false },
    "claim_boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": { "enum": ["passed", "pending", "blocked"] },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reviewer_independent": { "type": "boolean" }
      }
    }
  }
}
