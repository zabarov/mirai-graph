{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/technology-draft.schema.json",
  "title": "Mirai Technology Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "version", "goal", "roles", "inputs", "outputs", "state", "imports", "steps", "entry", "gates", "policies", "terminal_conditions", "diagnostics", "source_ref", "confidence", "canonical_write_allowed"],
  "properties": {
    "contract_version": { "const": "1.0.0" }, "id": { "type": "string" }, "version": { "type": "string" }, "goal": { "type": "string", "minLength": 1 },
    "roles": { "type": "array", "items": { "type": "string" } }, "inputs": { "type": "array" }, "outputs": { "type": "array" }, "state": { "type": "array" }, "imports": { "type": "array" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["action", "branch", "foreach", "parallel", "await", "return"] }
        }
      }
    },
    "entry": { "type": "string", "minLength": 1 }, "gates": { "type": "array", "items": { "type": "string" } }, "policies": { "type": "object" },
    "terminal_conditions": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "diagnostics": { "type": "array" }, "source_ref": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "canonical_write_allowed": { "const": false }
  }
}
