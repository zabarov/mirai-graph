{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/retrieval-answer.schema.json",
  "title": "Mirai Evidence-Bound Retrieval Answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "intent", "status", "answer", "claims", "relevant_relationships", "program_candidates", "policy_refs", "conflicts", "limitations", "next_safe_action", "execution_allowed", "content_is_untrusted_data", "canonical_write_allowed", "evidence_bundle_digest", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" }, "request_id": { "type": "string" }, "intent": { "type": "string" }, "status": { "enum": ["answered", "clarification_required", "insufficient_evidence", "partial"] }, "answer": { "type": "string" },
    "claims": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["text", "evidence_refs", "source_refs"], "properties": { "text": { "type": "string" }, "evidence_refs": { "$ref": "#/$defs/strings" }, "source_refs": { "$ref": "#/$defs/strings" } } } },
    "relevant_relationships": { "type": "array" }, "program_candidates": { "type": "array", "items": { "type": "string" } }, "policy_refs": { "type": "array", "items": { "type": "string" } }, "conflicts": { "type": "array", "items": { "type": "string" } }, "limitations": { "type": "array", "items": { "type": "string" } }, "next_safe_action": { "type": "string" }, "execution_allowed": { "const": false }, "content_is_untrusted_data": { "const": true }, "canonical_write_allowed": { "const": false }, "evidence_bundle_digest": { "$ref": "#/$defs/digest" }, "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "strings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
}
