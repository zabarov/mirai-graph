{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/outcome-completion-contract.schema.json",
  "title": "Mirai Outcome Completion Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "goal", "scope", "outcome_kind", "required_slots", "optional_slots", "completion_policy", "interaction_policy", "conflict_policy", "template_authority", "execution_allowed", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "goal": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "scope": { "type": "object", "additionalProperties": false, "required": ["purpose", "domains", "effect"], "properties": { "purpose": { "$ref": "#/$defs/id" }, "domains": { "$ref": "#/$defs/ids" }, "effect": { "enum": ["read_only", "effectful"] } } },
    "outcome_kind": { "$ref": "#/$defs/id" },
    "required_slots": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/slot" } },
    "optional_slots": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/slot" } },
    "completion_policy": { "type": "object", "additionalProperties": false, "required": ["allow_partial", "all_critical_required"], "properties": { "allow_partial": { "type": "boolean" }, "all_critical_required": { "const": true } } },
    "interaction_policy": { "type": "object", "additionalProperties": false, "required": ["max_questions", "ask_one_at_a_time"], "properties": { "max_questions": { "type": "integer", "minimum": 0, "maximum": 16 }, "ask_one_at_a_time": { "type": "boolean" } } },
    "conflict_policy": { "type": "object", "additionalProperties": false, "required": ["critical_conflict", "noncritical_conflict"], "properties": { "critical_conflict": { "const": "block" }, "noncritical_conflict": { "enum": ["report", "block"] } } },
    "template_authority": { "enum": ["owner_approved", "ephemeral_read_only"] },
    "parent_contract_digest": { "$ref": "#/$defs/digest" },
    "execution_allowed": { "const": false },
    "canonical_write_allowed": { "const": false },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$" },
    "ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "slot": { "type": "object", "additionalProperties": false, "required": ["id", "label", "value_type", "critical", "acquisition", "evidence_required", "minimum_authority", "freshness_required"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1, "maxLength": 256 },
      "value_type": { "enum": ["boolean", "string", "int64", "decimal", "timestamp", "duration", "identifier", "reference", "record", "list", "map"] },
      "critical": { "type": "boolean" }, "acquisition": { "enum": ["user_input", "evidence", "operation", "derived"] }, "evidence_required": { "type": "boolean" },
      "minimum_authority": { "enum": ["canonical_external", "canonical", "owner_asserted", "supporting", "informational", "derived", "proposal"] },
      "freshness_required": { "enum": ["current", "allow_aging", "allow_stale"] }
    } }
  }
}
