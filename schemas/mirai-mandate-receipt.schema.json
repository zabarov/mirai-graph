{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-mandate-receipt.schema.json",
  "title": "Mirai Host-Local Mandate Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "mandate_id", "status", "subject", "issuer", "run_id", "program_digest", "input_digest", "policy_digest", "request_scopes", "issued_at", "expires_at", "canonical_write_allowed", "signature_algorithm", "signature"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "mandate_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "revoked"] },
    "subject": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "program_digest": { "$ref": "#/$defs/digest" },
    "input_digest": { "$ref": "#/$defs/digest" },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "request_scopes": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revocation_ref": { "type": "string", "minLength": 1 },
    "canonical_write_allowed": { "const": false },
    "signature_algorithm": { "const": "hmac-sha256-local" },
    "signature": { "type": "string", "pattern": "^hmac-sha256:[a-f0-9]{64}$" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "revoked" } } }, "then": { "required": ["revocation_ref"] } }
  ],
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
