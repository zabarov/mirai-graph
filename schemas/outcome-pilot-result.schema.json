{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/outcome-pilot-result.schema.json",
  "title": "Mirai Outcome Completion Controlled Pilot Result",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "pilot_id", "mode", "cases", "metrics", "hard_gate_violations", "limitations", "production_effects", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" }, "pilot_id": { "type": "string" }, "mode": { "enum": ["shadow_no_send", "synthetic"] },
    "cases": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "expected_status", "actual_status", "assessment_digest", "evidence_coverage", "question_count", "citation_count"], "properties": { "id": { "type": "string" }, "expected_status": { "type": "string" }, "actual_status": { "type": "string" }, "assessment_digest": { "$ref": "#/$defs/digest" }, "evidence_coverage": { "type": "number", "minimum": 0, "maximum": 1 }, "question_count": { "type": "integer", "minimum": 0 }, "citation_count": { "type": "integer", "minimum": 0 } } } },
    "metrics": { "type": "object", "additionalProperties": false, "required": ["status_accuracy", "mean_evidence_coverage", "unsupported_completion_rate", "replay_stability", "cold_start_latency_ms", "semantic_ready_latency_ms", "delivery_latency_ms"], "properties": { "status_accuracy": { "type": "number" }, "mean_evidence_coverage": { "type": "number" }, "unsupported_completion_rate": { "type": "number" }, "replay_stability": { "type": "number" }, "cold_start_latency_ms": { "type": "number" }, "semantic_ready_latency_ms": { "type": "number" }, "delivery_latency_ms": { "type": "number" } } },
    "hard_gate_violations": { "type": "object", "additionalProperties": false, "required": ["accepted_without_evidence", "unauthorized_effects", "automatic_canonical_updates", "silent_conflict_resolutions"], "properties": { "accepted_without_evidence": { "type": "integer", "minimum": 0 }, "unauthorized_effects": { "type": "integer", "minimum": 0 }, "automatic_canonical_updates": { "type": "integer", "minimum": 0 }, "silent_conflict_resolutions": { "type": "integer", "minimum": 0 } } },
    "limitations": { "type": "array", "items": { "type": "string" } }, "production_effects": { "const": false }, "canonical_write_allowed": { "const": false }, "digest": { "$ref": "#/$defs/digest" }
  }, "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
