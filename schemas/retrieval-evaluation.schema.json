{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/retrieval-evaluation.schema.json",
  "title": "Mirai Retrieval Evaluation",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "corpus_id", "system", "recall_at_k", "ndcg_at_k", "mrr", "intent_accuracy", "path_correctness", "evidence_coverage", "unauthorized_hit_count", "stale_hit_rate", "p50_latency_ms", "p95_latency_ms", "limitations", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" }, "corpus_id": { "type": "string", "minLength": 1 }, "system": { "enum": ["lexical", "semantic", "graph", "hybrid", "mirai_planner"] }, "recall_at_k": { "$ref": "#/$defs/rate" }, "ndcg_at_k": { "$ref": "#/$defs/rate" }, "mrr": { "$ref": "#/$defs/rate" }, "intent_accuracy": { "$ref": "#/$defs/rate" }, "path_correctness": { "$ref": "#/$defs/rate" }, "evidence_coverage": { "$ref": "#/$defs/rate" }, "unauthorized_hit_count": { "type": "integer", "minimum": 0 }, "stale_hit_rate": { "$ref": "#/$defs/rate" }, "p50_latency_ms": { "type": "number", "minimum": 0 }, "p95_latency_ms": { "type": "number", "minimum": 0 }, "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "rate": { "type": "number", "minimum": 0, "maximum": 1 }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
