{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-sanitized-evidence.schema.json",
  "title": "Mirai Sanitized Runtime Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run", "episode", "receipts", "exported_at", "canonical_write_allowed", "limitations"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "run_id", "graph_id", "program_id", "program_digest", "input_digest", "status", "revision", "event_sequence", "apply_requested", "created_at", "updated_at", "blocker_codes", "limitations", "program_ref", "input_ref", "checkpoint_ref", "sandbox_ref"],
      "properties": {
        "contract_version": { "const": "1.0.0" },
        "run_id": { "type": "string", "minLength": 1 },
        "graph_id": { "type": "string", "minLength": 1 },
        "program_id": { "type": "string", "minLength": 1 },
        "program_digest": { "$ref": "#/$defs/digest" },
        "input_digest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["prepared", "running", "completed", "cancelled", "failed", "blocked"] },
        "revision": { "type": "integer", "minimum": 1 },
        "event_sequence": { "type": "integer", "minimum": 0 },
        "apply_requested": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "blocker_codes": { "type": "array", "items": { "type": "string", "maxLength": 128 } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "program_ref": { "const": "program.json" },
        "input_ref": { "const": "input.json" },
        "checkpoint_ref": { "const": "checkpoint.json" },
        "episode_ref": { "const": "episode.json" },
        "sandbox_ref": { "const": "redacted-host-local" }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "episode_id", "run_id", "program_id", "program_digest", "input_digest", "status", "output_digest", "trace_digest", "steps", "logical_duration_ms", "effects_executed", "replay_input_digest", "effect_summaries", "canonical_write_allowed", "learning_update_allowed", "limitations"],
      "properties": {
        "contract_version": { "const": "1.0.0" },
        "episode_id": { "type": "string" }, "run_id": { "type": "string" }, "program_id": { "type": "string" },
        "program_digest": { "$ref": "#/$defs/digest" }, "input_digest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["completed", "cancelled"] }, "output_digest": { "$ref": "#/$defs/digest" },
        "trace_digest": { "$ref": "#/$defs/digest" }, "steps": { "type": "integer", "minimum": 1 },
        "logical_duration_ms": { "type": "integer", "minimum": 1 }, "effects_executed": { "type": "boolean" },
        "replay_input_digest": { "$ref": "#/$defs/digest" }, "effect_summaries": { "type": "array", "items": { "$ref": "#/$defs/effect_summary" } },
        "canonical_write_allowed": { "const": false }, "learning_update_allowed": { "const": false },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "receipts": { "type": "array", "items": { "$ref": "#/$defs/receipt" } },
    "exported_at": { "type": "string", "format": "date-time" },
    "canonical_write_allowed": { "const": false },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "effect_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "node_id", "invocation_id", "adapter", "operation", "args_digest", "status"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 }, "receipt_id": { "type": "string" },
        "node_id": { "type": "string" }, "invocation_id": { "type": "string" }, "adapter": { "type": "string" }, "operation": { "type": "string" },
        "args_digest": { "$ref": "#/$defs/digest" }, "status": { "enum": ["verified", "compensated", "failed"] },
        "result_digest": { "$ref": "#/$defs/digest" }, "error_code": { "type": "string", "maxLength": 128 }, "error_message_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "receipt_id", "sequence", "idempotency_key", "run_id", "program_id", "program_digest", "node_id", "invocation_id", "adapter", "operation", "effects", "args_digest", "status", "attempt", "prepared_at"],
      "properties": {
        "contract_version": { "const": "1.0.0" }, "receipt_id": { "type": "string" }, "sequence": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "$ref": "#/$defs/digest" }, "run_id": { "type": "string" }, "program_id": { "type": "string" }, "program_digest": { "$ref": "#/$defs/digest" },
        "node_id": { "type": "string" }, "invocation_id": { "type": "string" }, "adapter": { "type": "string" }, "operation": { "type": "string" },
        "effects": { "type": "array", "items": { "enum": ["repository_read", "git_read", "workspace_patch", "process_run", "human_approval"] }, "uniqueItems": true },
        "args_digest": { "$ref": "#/$defs/digest" }, "status": { "enum": ["prepared", "executed", "verified", "failed", "uncertain", "compensated"] }, "attempt": { "type": "integer", "minimum": 1 },
        "prepared_at": { "type": "string", "format": "date-time" }, "executed_at": { "type": "string", "format": "date-time" }, "verified_at": { "type": "string", "format": "date-time" },
        "failed_at": { "type": "string", "format": "date-time" }, "reconciled_at": { "type": "string", "format": "date-time" }, "compensated_at": { "type": "string", "format": "date-time" },
        "result_digest": { "$ref": "#/$defs/digest" }, "verification_status": { "enum": ["verified", "not_verified", "unsupported"] },
        "failure_code": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }, "failure_code_digest": { "$ref": "#/$defs/digest" }, "retry_safe": { "type": "boolean" },
        "compensation_status": { "enum": ["available", "not_available", "completed"] }, "backup_ref": { "const": "redacted-host-local" }
      }
    }
  }
}
