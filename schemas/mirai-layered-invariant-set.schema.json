{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-layered-invariant-set.schema.json",
  "title": "Mirai Layered Invariant Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "version", "rules", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "decision", "protected", "adapters", "operations", "effects", "resource_prefixes", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "layer": { "enum": ["system", "organization", "program", "project", "task"] },
          "decision": { "enum": ["allow", "deny"] },
          "protected": { "type": "boolean" },
          "adapters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "operations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "effects": { "type": "array", "items": { "enum": ["repository_read", "git_read", "workspace_patch", "process_run", "human_approval"] }, "uniqueItems": true },
          "resource_prefixes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "canonical_write_allowed": { "const": false },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
