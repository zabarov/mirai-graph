{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/autonomy-envelope.schema.json",
  "title": "Mirai Autonomy Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "scope", "allowed_change_kinds", "forbidden_targets", "risk_ceiling", "confidence_floor", "evidence_requirements", "replay_requirements", "resource_patterns", "change_budget", "issued_at", "expires_at", "rollback_contract", "policy_digest", "approver_signatures", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" }, "id": { "type": "string" }, "scope": { "type": "string" },
    "allowed_change_kinds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/changeKind" } },
    "forbidden_targets": { "type": "array", "items": { "type": "string" } }, "risk_ceiling": { "enum": ["low", "medium"] },
    "confidence_floor": { "type": "number", "minimum": 0, "maximum": 1 }, "evidence_requirements": { "type": "array", "items": { "type": "string" } },
    "replay_requirements": { "type": "object", "required": ["required_for", "minimum_successful_replays"], "properties": { "required_for": { "type": "array", "items": { "$ref": "#/$defs/changeKind" } }, "minimum_successful_replays": { "type": "integer", "minimum": 0 } } },
    "resource_patterns": { "type": "array", "items": { "type": "string", "pattern": "^adaptive/" } },
    "change_budget": { "type": "object", "required": ["max_changes", "max_payload_bytes"], "properties": { "max_changes": { "type": "integer", "minimum": 1 }, "max_payload_bytes": { "type": "integer", "minimum": 1 } } },
    "issued_at": { "type": "string", "format": "date-time" }, "expires_at": { "type": "string", "format": "date-time" },
    "rollback_contract": { "type": "object", "required": ["required", "retention_ms", "verify_readback"], "properties": { "required": { "const": true }, "retention_ms": { "type": "integer", "minimum": 1 }, "verify_readback": { "const": true } } },
    "policy_digest": { "$ref": "#/$defs/digest" }, "approver_signatures": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["signer_ref", "signature_ref", "signature_digest"] } },
    "canonical_write_allowed": { "const": false }, "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "changeKind": { "enum": ["source_freshness", "derived_navigation", "reviewed_alias", "adaptive_statistic", "effect_free_program"] }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
