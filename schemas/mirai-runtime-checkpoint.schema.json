{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-runtime-checkpoint.schema.json",
  "title": "Mirai Runtime Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "revision", "status", "event_sequence", "verified_receipt_ids", "uncertain_receipt_ids", "updated_at", "resume_strategy"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "$ref": "#/$defs/status" },
    "event_sequence": { "type": "integer", "minimum": 0 },
    "verified_receipt_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "uncertain_receipt_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "updated_at": { "type": "string", "format": "date-time" },
    "resume_strategy": { "const": "deterministic_restart_with_receipt_deduplication" }
  },
  "$defs": { "status": { "enum": ["prepared", "running", "completed", "cancelled", "failed", "blocked"] } }
}
