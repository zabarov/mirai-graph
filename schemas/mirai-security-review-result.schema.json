{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-security-review-result.schema.json",
  "title": "Mirai Independent Security Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "review_id", "status", "evidence_class", "reviewed_repository", "reviewed_revision", "reviewer", "scope", "methods", "findings", "unresolved_risks", "verdict", "adapter_scope", "reviewed_at", "attestation", "claim_boundary"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "review_id": { "type": "string", "pattern": "^security-review\\.[a-z0-9._-]+$" },
    "status": { "enum": ["draft", "complete"] },
    "evidence_class": { "enum": ["template", "external_review"] },
    "reviewed_repository": { "const": "https://github.com/zabarov/mirai-graph" },
    "reviewed_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "independent", "implemented_reviewed_changes", "conflict_declaration"],
      "properties": {
        "alias": { "type": "string", "minLength": 1 },
        "independent": { "type": "boolean" },
        "implemented_reviewed_changes": { "type": "boolean" },
        "conflict_declaration": { "type": "string", "minLength": 1 }
      }
    },
    "scope": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "methods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status", "summary", "reproduction", "evidence_refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^SEC-[0-9]{3,}$" },
          "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
          "status": { "enum": ["open", "fixed", "accepted_risk", "not_reproducible"] },
          "summary": { "type": "string", "minLength": 1 },
          "reproduction": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "unresolved_risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "verdict": { "enum": ["pass_for_production_read", "pass_for_bounded_production_write", "changes_required", "not_reviewable"] },
    "adapter_scope": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "attestation": { "type": "string", "minLength": 1 },
    "claim_boundary": { "type": "string", "minLength": 1 }
  }
}
