{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/federated-query-result.schema.json",
  "title": "Mirai Federated Query Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "query_id", "responder_graph_id", "query_digest", "index_digest", "graph_digest", "policy_digest", "evidence_bundle", "status", "blockers", "usage", "instructions_authorized", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" }, "query_id": { "type": "string", "minLength": 1 }, "responder_graph_id": { "type": "string", "minLength": 1 }, "query_digest": { "$ref": "#/$defs/digest" }, "index_digest": { "$ref": "#/$defs/digest" }, "graph_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "policy_digest": { "$ref": "#/$defs/digest" }, "evidence_bundle": { "$ref": "#/$defs/evidence" }, "status": { "enum": ["complete", "partial", "blocked"] }, "blockers": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "usage": { "type": "object", "additionalProperties": false, "required": ["tokens_used", "cost_used", "duration_ms"], "properties": { "tokens_used": { "type": "integer", "minimum": 0 }, "cost_used": { "type": "number", "minimum": 0 }, "duration_ms": { "type": "number", "minimum": 0 } } }, "instructions_authorized": { "const": false }, "canonical_write_allowed": { "const": false }, "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "evidence": { "type": "object", "additionalProperties": false, "required": ["contract_version", "query_digest", "index_digest", "graph_digest", "policy_digest", "hits", "source_refs", "conflicts", "limitations", "partial", "instructions_authorized", "canonical_write_allowed", "digest"], "properties": { "contract_version": { "const": "1.0.0" }, "query_digest": { "$ref": "#/$defs/digest" }, "index_digest": { "$ref": "#/$defs/digest" }, "graph_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "policy_digest": { "$ref": "#/$defs/digest" }, "hits": { "type": "array", "items": { "type": "object", "required": ["document_id", "source_ref", "scope", "evidence_refs", "instructions_authorized"], "properties": { "document_id": { "type": "string" }, "source_ref": { "type": "string" }, "scope": { "type": "string" }, "evidence_refs": { "type": "array", "items": { "type": "string" } }, "instructions_authorized": { "const": false } } } }, "source_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "conflicts": { "type": "array", "items": { "type": "string" } }, "limitations": { "type": "array", "items": { "type": "string" } }, "partial": { "type": "boolean" }, "instructions_authorized": { "const": false }, "canonical_write_allowed": { "const": false }, "digest": { "$ref": "#/$defs/digest" } } } }
}
