{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/federated-query-result.schema.json",
  "title": "Mirai Federated Query Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "query_id", "responder_graph_id", "query_digest", "index_digest", "graph_digest", "policy_digest", "evidence_bundle", "status", "blockers", "instructions_authorized", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" }, "query_id": { "type": "string" }, "responder_graph_id": { "type": "string" }, "query_digest": { "$ref": "#/$defs/digest" }, "index_digest": { "$ref": "#/$defs/digest" }, "graph_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "policy_digest": { "$ref": "#/$defs/digest" }, "evidence_bundle": { "type": "object" }, "status": { "enum": ["complete", "partial", "blocked"] }, "blockers": { "type": "array", "items": { "type": "string" } }, "instructions_authorized": { "const": false }, "canonical_write_allowed": { "const": false }, "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
