{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/federated-query-result.schema.json",
  "title": "Mirai Federated Query Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "query_id", "responder_graph_id", "query_digest", "index_digest", "graph_digest", "policy_digest", "evidence_bundle", "status", "blockers", "usage", "instructions_authorized", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "query_id": { "type": "string", "minLength": 1 },
    "responder_graph_id": { "type": "string", "minLength": 1 },
    "query_digest": { "$ref": "#/$defs/digest" },
    "index_digest": { "$ref": "#/$defs/digest" },
    "graph_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "evidence_bundle": { "$ref": "#/$defs/evidence" },
    "status": { "enum": ["complete", "partial", "blocked"] },
    "blockers": { "$ref": "#/$defs/strings" },
    "usage": { "type": "object", "additionalProperties": false, "required": ["tokens_used", "cost_used", "duration_ms"], "properties": { "tokens_used": { "type": "integer", "minimum": 0 }, "cost_used": { "type": "number", "minimum": 0 }, "duration_ms": { "type": "number", "minimum": 0 } } },
    "instructions_authorized": { "const": false },
    "canonical_write_allowed": { "const": false },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "kind", "title", "snippet", "source_ref", "scope", "authority", "freshness", "graph_object_refs", "evidence_refs", "program_refs", "policy_refs", "channels", "rank_score", "match_reasons", "instructions_authorized", "canonical_write_allowed"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "minLength": 1 }, "title": { "type": "string" }, "snippet": { "type": "string" }, "source_ref": { "type": "string", "minLength": 1 }, "scope": { "type": "string", "minLength": 1 },
        "authority": { "enum": ["informational", "supporting", "owner_asserted", "canonical_external", "canonical", "derived", "proposal"] }, "freshness": { "enum": ["current", "aging", "stale", "unknown"] },
        "graph_object_refs": { "$ref": "#/$defs/strings" }, "evidence_refs": { "$ref": "#/$defs/strings" }, "program_refs": { "$ref": "#/$defs/strings" }, "policy_refs": { "$ref": "#/$defs/strings" }, "conflict_refs": { "$ref": "#/$defs/strings" },
        "channels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["exact", "lexical", "semantic", "graph", "process"] } }, "rank_score": { "type": "number" }, "match_reasons": { "$ref": "#/$defs/strings" }, "graph_path": { "$ref": "#/$defs/strings" },
        "instructions_authorized": { "const": false }, "canonical_write_allowed": { "const": false }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "query_digest", "index_digest", "graph_digest", "policy_digest", "hits", "source_refs", "conflicts", "limitations", "partial", "instructions_authorized", "canonical_write_allowed", "digest"],
      "properties": {
        "contract_version": { "const": "1.0.0" }, "query_digest": { "$ref": "#/$defs/digest" }, "index_digest": { "$ref": "#/$defs/digest" }, "graph_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "policy_digest": { "$ref": "#/$defs/digest" },
        "hits": { "type": "array", "items": { "$ref": "#/$defs/hit" } }, "source_refs": { "$ref": "#/$defs/strings" }, "conflicts": { "$ref": "#/$defs/strings" }, "limitations": { "$ref": "#/$defs/strings" }, "partial": { "type": "boolean" },
        "instructions_authorized": { "const": false }, "canonical_write_allowed": { "const": false }, "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
