{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/retrieval-plan.schema.json",
  "title": "Mirai Retrieval Plan",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "request_digest", "intent", "channels", "filters", "budgets", "semantic_status", "diagnostics", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" }, "request_digest": { "$ref": "#/$defs/digest" }, "intent": { "enum": ["exact_lookup", "semantic_discovery", "relationship_trace", "technology_lookup", "policy_lookup", "evidence_lookup", "change_or_freshness", "global_synthesis"] }, "channels": { "type": "array", "uniqueItems": true, "items": { "enum": ["exact", "lexical", "semantic", "graph", "process"] } }, "filters": { "type": "object", "additionalProperties": false, "required": ["scopes", "source_refs", "freshness_required"], "properties": { "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "freshness_required": { "enum": ["current", "allow_aging", "allow_stale"] } } }, "budgets": { "type": "object", "additionalProperties": false, "required": ["max_results", "max_graph_depth", "max_fan_out", "max_hops", "timeout_ms"], "properties": { "max_results": { "type": "integer", "minimum": 1 }, "max_graph_depth": { "type": "integer", "minimum": 1, "maximum": 64 }, "max_fan_out": { "type": "integer", "minimum": 1, "maximum": 64 }, "max_hops": { "type": "integer", "minimum": 1, "maximum": 16 }, "timeout_ms": { "type": "integer", "minimum": 1 } } }, "semantic_status": { "enum": ["ready", "disabled", "provider_unavailable"] }, "diagnostics": { "type": "array", "items": { "type": "string" } }, "canonical_write_allowed": { "const": false }, "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
