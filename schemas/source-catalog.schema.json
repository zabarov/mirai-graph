{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/source-catalog.schema.json",
  "title": "Mirai Source Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "root", "items", "diagnostics", "policies", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "root": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "kind", "media_type", "bytes", "fingerprint", "provenance", "parser", "extracted_candidates"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["text", "markdown", "json", "yaml", "csv", "git_commit", "git_diff"] },
          "media_type": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "fingerprint": { "$ref": "#/$defs/digest" },
          "provenance": {
            "type": "object", "additionalProperties": false, "required": ["provider"],
            "properties": { "provider": { "enum": ["filesystem", "git"] }, "repository_ref": { "type": "string" }, "revision": { "type": "string" } }
          },
          "parser": { "type": "object", "additionalProperties": false, "required": ["provider", "version"], "properties": { "provider": { "type": "string" }, "version": { "type": "string" } } },
          "extracted_candidates": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["local_ref", "kind", "semantic_type", "label", "confidence"], "properties": { "local_ref": { "type": "string" }, "kind": { "enum": ["object", "relation"] }, "semantic_type": { "type": "string" }, "label": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } } } }
        }
      }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "policies": {
      "type": "object", "additionalProperties": false,
      "required": ["max_file_bytes", "follow_symlinks", "include_secrets", "supported_extensions"],
      "properties": {
        "max_file_bytes": { "type": "integer", "minimum": 1 }, "follow_symlinks": { "const": false }, "include_secrets": { "const": false },
        "supported_extensions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "canonical_write_allowed": { "const": false },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "diagnostic": {
      "type": "object", "additionalProperties": false, "required": ["code", "severity", "message"],
      "properties": { "code": { "type": "string" }, "path": { "type": "string" }, "severity": { "enum": ["info", "warning", "blocking"] }, "message": { "type": "string" } }
    }
  }
}
