{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirai-graph.dev/schemas/project-technology-extension.schema.json",
  "title": "Mirai Graph Project Technology Extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "enabled", "context_policy", "source_boundary"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "enabled": { "type": "boolean" },
    "context_policy": { "const": "task_scoped" },
    "source_boundary": { "const": "hybrid_sot" },
    "continuity_policy": { "enum": ["task_boundary"] },
    "target_source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target_id", "acceptance_ref"],
      "properties": {
        "kind": { "const": "local" },
        "target_id": { "type": "string", "minLength": 2 },
        "acceptance_ref": { "type": "string", "minLength": 2 }
      }
    }
  }
}
