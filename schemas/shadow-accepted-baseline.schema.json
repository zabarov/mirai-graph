{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/shadow-accepted-baseline.schema.json",
  "title": "Mirai Shadow Accepted Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "version", "source_ref", "acceptance", "mandatory_steps", "allowed_scope", "rollback_coverage", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "source_ref": { "type": "string", "minLength": 1 },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence_ref"],
      "properties": { "status": { "enum": ["owner_accepted", "tester_accepted"] }, "evidence_ref": { "type": "string", "minLength": 1 } }
    },
    "mandatory_steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "operation", "required_effects", "rollback_required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "operation": { "type": "string", "minLength": 1 },
          "component_instance": { "type": "string", "minLength": 1 },
          "required_effects": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "rollback_required": { "type": "boolean" }
        }
      }
    },
    "allowed_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["component_instances", "operations", "capabilities", "effects"],
      "properties": {
        "component_instances": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "operations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "effects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "rollback_coverage": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["step_id", "strategy_ref"], "properties": { "step_id": { "type": "string" }, "strategy_ref": { "type": "string", "minLength": 1 } } }
    },
    "canonical_write_allowed": { "const": false },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
