{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-effect-receipt.schema.json",
  "title": "Mirai Effect Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "receipt_id", "sequence", "idempotency_key", "run_id", "program_id", "program_digest", "node_id", "invocation_id", "adapter", "operation", "effects", "capability_grant_ref", "args_digest", "status", "attempt", "prepared_at"],
  "allOf": [{"if":{"properties":{"effects":{"contains":{"enum":["task_control","task_dispatch","inference_invoke","task_read"]}}},"required":["effects"]},"then":{"properties":{"contract_version":{"const":"1.1.0"}}},"else":{"properties":{"contract_version":{"const":"1.0.0"}}}}],
  "properties": {
    "contract_version": {"enum":["1.0.0","1.1.0"]},
    "receipt_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "idempotency_key": { "$ref": "#/$defs/digest" },
    "run_id": { "type": "string", "minLength": 1 },
    "program_id": { "type": "string", "minLength": 1 },
    "program_digest": { "$ref": "#/$defs/digest" },
    "node_id": { "type": "string", "minLength": 1 },
    "invocation_id": { "type": "string", "minLength": 1 },
    "adapter": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "effects": { "type": "array", "minItems": 1, "items": { "enum": ["repository_read","git_read","workspace_patch","process_run","human_approval","task_control","task_dispatch","inference_invoke","task_read"] } },
    "capability_grant_ref": { "type": "string", "minLength": 1 },
    "args_digest": { "$ref": "#/$defs/digest" },
    "status": { "enum": ["prepared", "executed", "verified", "failed", "uncertain", "compensated"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "prepared_at": { "type": "string", "format": "date-time" },
    "executed_at": { "type": "string", "format": "date-time" },
    "verified_at": { "type": "string", "format": "date-time" },
    "failed_at": { "type": "string", "format": "date-time" },
    "reconciled_at": { "type": "string", "format": "date-time" },
    "compensated_at": { "type": "string", "format": "date-time" },
    "result": true,
    "result_digest": { "$ref": "#/$defs/digest" },
    "verification": { "type": "object" },
    "failure": { "type": "object" },
    "compensation": { "type": "object" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
