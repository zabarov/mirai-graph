{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-conformance-corpus.schema.json",
  "title": "Mirai Language Conformance Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "cases"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "program"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "program": { "type": "string", "minLength": 1 },
          "input": { "type": "object" },
          "events": { "type": "object" },
          "imports": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "expected_outputs": { "type": "object" },
          "expected_status": { "enum": ["completed", "cancelled"] },
          "expected_decisions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "expected_emitted_events": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "repetitions": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "expected_validation_error": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
