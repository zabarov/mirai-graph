{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/knowledge-proposal.schema.json",
  "title": "Mirai Knowledge Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "assertions", "identity_resolutions", "exact_duplicate_groups", "conflicts", "relation_facts", "stale_assertion_ids", "diagnostics", "quality", "budgets", "canonical_write_allowed", "next_safe_action", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
    "identity_resolutions": { "type": "array", "items": { "type": "object", "required": ["candidate_identity", "resolution", "candidate_matches", "owner_review_required"] } },
    "exact_duplicate_groups": { "type": "array" },
    "conflicts": { "type": "array", "items": { "type": "object", "required": ["id", "identity_key", "predicate", "assertion_ids", "value_digests", "resolution"], "properties": { "resolution": { "const": "owner_review_required" } } } },
    "relation_facts": { "type": "array", "items": { "type": "object", "required": ["id", "type", "participants", "qualifiers", "scope", "authority", "confidence", "provenance", "lifecycle"] } },
    "stale_assertion_ids": { "type": "array", "items": { "type": "string" } }, "diagnostics": { "type": "array" },
    "quality": { "type": "object", "required": ["provenance_coverage", "conflict_count", "ambiguous_identity_count", "proposal_noise_ratio", "readiness"] },
    "budgets": { "type": "object" },
    "growth_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "dimension", "observed", "limit", "suggested_actions", "automatic_pruning_allowed", "proposal_only"],
      "properties": {
        "status": { "enum": ["partitioning_required", "pruning_review_required"] },
        "dimension": { "enum": ["units", "assertions", "relations", "conflicts"] },
        "observed": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1 },
        "suggested_actions": { "type": "array", "uniqueItems": true, "items": { "enum": ["partition_by_source_scope", "partition_by_fingerprint_prefix", "review_exact_duplicates", "review_stale_and_superseded"] } },
        "automatic_pruning_allowed": { "const": false },
        "proposal_only": { "const": true }
      }
    },
    "canonical_write_allowed": { "const": false },
    "next_safe_action": { "enum": ["owner_review", "resolve_conflicts", "reduce_scope", "partition_source", "review_pruning"] }, "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "assertion": {
      "type": "object",
      "required": ["contract_version", "id", "identity_key", "semantic_type", "label", "predicate", "value", "value_digest", "scope", "confidentiality", "quality", "provenance", "lifecycle", "source_state", "authority_decision_required", "canonical_write_allowed"],
      "properties": { "contract_version": { "const": "1.0.0" }, "quality": { "type": "object", "required": ["extraction_confidence", "source_authority", "corroboration_count", "freshness", "conflict_state"] }, "provenance": { "type": "array", "minItems": 1 }, "canonical_write_allowed": { "const": false } }
    }
  }
}
