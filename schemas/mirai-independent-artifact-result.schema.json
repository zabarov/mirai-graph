{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-independent-artifact-result.schema.json",
  "title": "Mirai Independent Artifact Conformance Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "implementation",
    "artifact_type",
    "source_ref",
    "schema_ref",
    "status",
    "checks",
    "errors",
    "limitations"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "implementation": { "const": "python_independent" },
    "artifact_type": { "enum": ["pure_episode", "sanitized_runtime_evidence"] },
    "source_ref": { "$ref": "#/$defs/ref" },
    "schema_ref": { "$ref": "#/$defs/ref" },
    "program_ref": { "$ref": "#/$defs/ref" },
    "status": { "enum": ["passed", "failed"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "errors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:\\\\)" }
    }
  }
}
