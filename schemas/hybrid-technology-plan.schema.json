{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/hybrid-technology-plan.schema.json",
  "title": "Mirai Hybrid Technology Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "version", "goal", "source_ref", "draft_digest", "qualification_digest", "qualification_status", "entry", "operations", "control_steps", "gates", "terminal_conditions", "requires_human_coordination", "activation_allowed", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "source_ref": { "type": "string", "minLength": 1 },
    "draft_digest": { "$ref": "#/$defs/digest" },
    "qualification_digest": { "$ref": "#/$defs/digest" },
    "qualification_status": { "enum": ["instruction_only", "hybrid_ready", "executable_ready"] },
    "entry": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "operation", "classification", "acceptance", "reason", "mode", "next", "on_error", "effects"],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["executable", "verifiable", "advisory", "decision", "unsupported"] },
          "acceptance": { "enum": ["unreviewed", "owner_accepted", "tester_accepted"] },
          "acceptance_ref": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["program_operation", "verification_gate", "advisory_checkpoint", "decision_checkpoint", "unsupported_blocker"] },
          "next": { "type": "string" },
          "on_error": { "type": "string" },
          "program_ref": { "type": "string", "minLength": 1 },
          "adapter": { "type": "string", "minLength": 1 },
          "effects": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "capability": { "type": "string", "minLength": 1 },
          "verification_ref": { "type": "string", "minLength": 1 },
          "owner_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "control_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["branch", "foreach", "parallel", "await", "return"] }
        }
      }
    },
    "gates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "terminal_conditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "runtime_program_digest": { "$ref": "#/$defs/digest" },
    "requires_human_coordination": { "type": "boolean" },
    "activation_allowed": { "const": false },
    "canonical_write_allowed": { "const": false },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
