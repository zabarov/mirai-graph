{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-power-analysis-readiness.schema.json",
  "title": "Mirai Power Analysis Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "study_id", "status", "pilot_independent_task_counts", "variance_estimates", "blockers", "next_action", "claim_boundary"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "study_id": { "type": "string", "pattern": "^study\\.[a-z0-9._-]+$" },
    "status": { "enum": ["insufficient_evidence", "ready", "complete"] },
    "pilot_independent_task_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["federation", "larena_code_generation", "ai_employee"],
      "properties": {
        "federation": { "type": "integer", "minimum": 0 },
        "larena_code_generation": { "type": "integer", "minimum": 0 },
        "ai_employee": { "type": "integer", "minimum": 0 }
      }
    },
    "variance_estimates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technology_adherence"],
      "properties": {
        "technology_adherence": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "next_action": { "type": "string", "minLength": 1 },
    "claim_boundary": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "insufficient_evidence" } }, "required": ["status"] },
      "then": {
        "properties": {
          "blockers": { "minItems": 1 },
          "variance_estimates": { "properties": { "technology_adherence": { "type": "null" } } }
        }
      }
    }
  ]
}
