{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/federated-query-envelope.schema.json",
  "title": "Mirai Federated Query Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "origin_graph_id", "requester", "query", "intent", "target_domains", "visited_graph_ids", "max_hops", "max_fan_out", "deadline", "token_budget", "cost_budget", "freshness_required", "canonical_write_allowed"],
  "properties": {
    "contract_version": { "const": "1.0.0" }, "id": { "type": "string", "minLength": 1 }, "origin_graph_id": { "type": "string", "minLength": 1 }, "requester": { "type": "object" }, "query": { "type": "string", "minLength": 1 }, "intent": { "type": "string" }, "target_domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "visited_graph_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "max_hops": { "type": "integer", "minimum": 1, "maximum": 16 }, "max_fan_out": { "type": "integer", "minimum": 1, "maximum": 64 }, "deadline": { "type": "string", "format": "date-time" }, "token_budget": { "type": "number", "minimum": 0 }, "cost_budget": { "type": "number", "minimum": 0 }, "freshness_required": { "enum": ["current", "allow_aging", "allow_stale"] }, "canonical_write_allowed": { "const": false }
  }
}
