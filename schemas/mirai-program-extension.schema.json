{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-program-extension.schema.json",
  "title": "Mirai Program Manifest Extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "programs"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source": { "$ref": "#/$defs/relativePath" },
          "compiled": { "$ref": "#/$defs/relativePath" },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "default_program": { "$ref": "#/$defs/id" },
    "canonical_write_allowed": { "const": false }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+*?=-]{1,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/]|.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))" }
    }
  }
}
