{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/outcome-delivery-plan.schema.json",
  "title": "Mirai Outcome Delivery Plan",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "id", "assessment_digest", "status", "confirmed_facts", "gaps", "question", "useful_next_step", "citations", "handoff_route", "limitations", "execution_allowed", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" }, "id": { "type": "string" }, "assessment_digest": { "$ref": "#/$defs/digest" }, "status": { "$ref": "#/$defs/status" },
    "confirmed_facts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["slot_id", "value", "evidence_refs", "source_refs"], "properties": { "slot_id": { "type": "string" }, "value": {}, "evidence_refs": { "allOf": [{ "$ref": "#/$defs/strings" }, { "minItems": 1 }] }, "source_refs": { "allOf": [{ "$ref": "#/$defs/strings" }, { "minItems": 1 }] } } } },
    "gaps": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["slot_id", "state", "reasons"], "properties": { "slot_id": { "type": "string" }, "state": { "enum": ["missing", "stale", "conflicting", "unsupported", "unauthorized", "invalid"] }, "reasons": { "$ref": "#/$defs/strings" } } } },
    "question": { "type": ["string", "null"] }, "useful_next_step": { "type": "string" }, "citations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["evidence_ref", "source_ref"], "properties": { "evidence_ref": { "type": "string" }, "source_ref": { "type": "string" } } } },
    "handoff_route": { "type": ["string", "null"] }, "limitations": { "$ref": "#/$defs/strings" }, "execution_allowed": { "const": false }, "canonical_write_allowed": { "const": false }, "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "status": { "enum": ["satisfied", "partially_satisfied", "needs_input", "blocked_by_conflict", "out_of_scope", "insufficient_evidence", "handoff_required", "temporarily_unavailable", "failed"] } }
}
