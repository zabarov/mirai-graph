{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/outcome-evidence-set.schema.json",
  "title": "Mirai Outcome Evidence Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "snapshot_digest", "policy_digest", "items", "partial", "limitations", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "snapshot_digest": { "$ref": "#/$defs/digest" },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "items": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_ref", "contract_digest", "slot_id", "value_digest", "admission_receipt_digest", "authority", "freshness", "conflict_refs", "authorized", "digest"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source_ref": { "$ref": "#/$defs/id" },
          "contract_digest": { "$ref": "#/$defs/digest" },
          "slot_id": { "$ref": "#/$defs/id" },
          "value_digest": { "$ref": "#/$defs/digest" },
          "admission_receipt_digest": { "$ref": "#/$defs/digest" },
          "authority": { "enum": ["canonical_external", "canonical", "owner_asserted", "supporting", "informational", "derived", "proposal"] },
          "freshness": { "enum": ["current", "aging", "stale", "unknown"] },
          "conflict_refs": { "$ref": "#/$defs/ids" },
          "authorized": { "type": "boolean" },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "partial": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "canonical_write_allowed": { "const": false },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
