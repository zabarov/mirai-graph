{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-contract-freeze-candidate.schema.json",
  "title": "Mirai Contract Freeze Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "id",
    "status",
    "baseline_commit",
    "base_product_line",
    "additive_product_line",
    "surfaces",
    "compatibility",
    "change_policy",
    "claim_boundary"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^freeze\\.[a-z0-9._-]+$" },
    "status": { "const": "candidate" },
    "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "base_product_line": { "const": "2.0" },
    "additive_product_line": { "const": "2.1" },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contract_version", "product_line", "stability", "schema_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "contract_version": { "type": "string", "minLength": 1 },
          "product_line": { "enum": ["2.0", "2.1"] },
          "stability": { "enum": ["freeze_candidate", "draft"] },
          "schema_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirai_graph_wrapper_through", "legacy_schema_aliases_through", "program_1_0_compatible"],
      "properties": {
        "mirai_graph_wrapper_through": { "const": "2.x" },
        "legacy_schema_aliases_through": { "const": "2.x" },
        "program_1_0_compatible": { "const": true }
      }
    },
    "change_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["breaking_change", "security_fix", "documentation_fix"],
      "properties": {
        "breaking_change": { "const": "new_candidate_and_migration_required" },
        "security_fix": { "const": "allowed_with_review_and_evidence" },
        "documentation_fix": { "const": "allowed_if_semantics_unchanged" }
      }
    },
    "claim_boundary": { "type": "string", "minLength": 1 }
  }
}
