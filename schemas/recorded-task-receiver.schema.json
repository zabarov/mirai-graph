{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/recorded-task-receiver.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "id",
    "kind",
    "input_type",
    "output_type",
    "recordings"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
    },
    "kind": {
      "const": "recorded_ai"
    },
    "input_type": {
      "$ref": "https://zabarov.github.io/mirai/schemas/mirai-program.schema.json#/$defs/typeSpec"
    },
    "output_type": {
      "$ref": "https://zabarov.github.io/mirai/schemas/mirai-program.schema.json#/$defs/typeSpec"
    },
    "recordings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "input_digest",
          "view_digest",
          "dependencies_digest",
          "result"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
          },
          "input_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "view_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "dependencies_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "output",
              "evidence"
            ],
            "properties": {
              "output": {
                "type": "object",
                "maxProperties": 64
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "digest"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
