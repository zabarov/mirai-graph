{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/mirai-pure-episode.schema.json",
  "title": "Mirai Pure Episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "episode_id", "program_id", "program_digest",
    "input_digest", "replay_input", "status", "outputs", "output_digest",
    "final_state", "emitted_events", "trace", "trace_digest", "steps",
    "logical_duration_ms", "effects_executed", "canonical_write_allowed",
    "limitations"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "episode_id": { "type": "string", "minLength": 1 },
    "program_id": { "type": "string", "minLength": 1 },
    "program_digest": { "$ref": "#/$defs/digest" },
    "input_digest": { "$ref": "#/$defs/digest" },
    "replay_input": { "type": "object" },
    "status": { "enum": ["completed", "cancelled"] },
    "outputs": { "type": "object" },
    "output_digest": { "$ref": "#/$defs/digest" },
    "final_state": { "type": "object" },
    "emitted_events": { "type": "array", "items": { "type": "object" } },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "logical_time", "depth", "program_id", "node_id", "kind", "decision"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "logical_time": { "type": "integer", "minimum": 1 },
          "depth": { "type": "integer", "minimum": 0 },
          "program_id": { "type": "string", "minLength": 1 },
          "node_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 },
          "result_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "trace_digest": { "$ref": "#/$defs/digest" },
    "steps": { "type": "integer", "minimum": 1 },
    "logical_duration_ms": { "type": "integer", "minimum": 1 },
    "effects_executed": { "const": false },
    "canonical_write_allowed": { "const": false },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
