{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/task-policy.schema.json",
  "title": "Mirai bounded task host policy declaration, not a grant",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
    },
    "reviewers": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
      },
      "minItems": 1
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
          },
          "object_ids": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 10000,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
            }
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 10000,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
            }
          },
          "delegate_to": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
            }
          }
        },
        "required": [
          "id",
          "object_ids",
          "source_ids",
          "delegate_to"
        ]
      }
    },
    "max_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "max_tasks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "max_duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "max_model_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "id",
    "owner",
    "reviewers",
    "participants",
    "max_depth",
    "max_tasks",
    "max_parallel",
    "max_duration_ms",
    "max_output_bytes",
    "max_model_calls",
    "digest"
  ]
}
