{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabarov.github.io/mirai/schemas/process-candidate.schema.json",
  "title": "Mirai Process Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "process_hint", "mode", "observation_refs", "support_count", "control_flow", "confidence", "normative_authority_present", "technology_draft_allowed", "diagnostics", "canonical_write_allowed", "digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" }, "id": { "type": "string" }, "process_hint": { "type": "string" }, "mode": { "enum": ["intended", "observed"] },
    "observation_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "support_count": { "type": "integer", "minimum": 1 },
    "control_flow": { "type": "array", "items": { "type": "object", "required": ["ordinal", "operation", "conditions", "observed_outcomes", "effects"] } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "normative_authority_present": { "type": "boolean" }, "technology_draft_allowed": { "type": "boolean" },
    "diagnostics": { "type": "array" }, "canonical_write_allowed": { "const": false }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "allOf": [{ "if": { "properties": { "mode": { "const": "observed" } } }, "then": { "properties": { "technology_draft_allowed": { "const": false } } } }]
}
